#!/bin/sh
# git for Codex lanes. Each lane keeps its git data in lane-N.gitdir (not ".git"), so the
# Codex workspace sandbox can commit there. Never run this unsandboxed on a lane Codex has used.
LANES=$(cd "$(dirname "$0")/.." && pwd)
case "$PWD/" in
  # Literal prefix strip: the repo path may contain regex characters such as "+".
  "$LANES"/lane-[0-9]/*) rest=${PWD#"$LANES"/lane-}; n=${rest%%/*} ;;
  *) echo "lgit: run inside $LANES/lane-N" >&2; exit 2 ;;
esac
export GIT_DIR="$LANES/lane-$n.gitdir" GIT_WORK_TREE="$LANES/lane-$n"
exec /usr/bin/git "$@"
