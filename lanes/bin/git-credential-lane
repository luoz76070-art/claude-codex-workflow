#!/bin/sh
# Git credential helper for Codex lanes: the repo-only fine-grained PAT from the login keychain.
[ "$1" = get ] || exit 0
L=$(cd "$(dirname "$0")/.." && pwd)
S=$(cat "$L/token-service" 2>/dev/null) || exit 0
t=$(security find-generic-password -a codex -s "$S" -w 2>/dev/null) || exit 0
printf 'username=x-access-token\npassword=%s\n' "$t"
